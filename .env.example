# BIEM Cotiza — configuración local externa
# Copiar a .env y sustituir únicamente los valores de ejemplo.
# Nunca subir .env ni secretos a Git.

# PostgreSQL de Supabase: usar la conexión del pooler de transacciones para Vercel.
# Copiar la URL real desde Connect en Supabase; nunca exponerla en EXPO_PUBLIC_*.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST_DEL_POOLER:6543/postgres?sslmode=verify-full
# PGSSLROOTCERT=/ruta/al/certificado-ca-oficial-del-proveedor.pem

# Orígenes públicos del frontend y API
APP_PUBLIC_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Sesión del proveedor de autenticación externo: generar un secreto aleatorio de al menos 32 bytes.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS

# Seleccionar y configurar un proveedor externo antes de habilitar login.
# Ejemplos de nombres; adaptar al proveedor elegido y al código de autenticación resultante.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://hmdqdqwmxxivzaijkvzt.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_CLAVE_PUBLICABLE

# Almacenamiento externo (solo cuando se sustituya server/storage.ts y storageProxy.ts).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=biem-cotiza
# S3_ACCESS_KEY_ID=REEMPLAZAR
# S3_SECRET_ACCESS_KEY=REEMPLAZAR

# No incluir variables MANUS_*, BUILT_IN_FORGE_* ni credenciales de la plataforma Manus.
